<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.legal-workbench.feishu-local-sync</string>
  <key>ProgramArguments</key>
  <array>
    <string>/ABSOLUTE/PATH/TO/uv</string>
    <string>run</string>
    <string>--locked</string>
    <string>--project</string>
    <string>/ABSOLUTE/PATH/TO/legal-workbench/apps/backend</string>
    <string>python</string>
    <string>-m</string>
    <string>legal_workbench.integrations.feishu_local_connector</string>
    <string>--sync</string>
    <string>--authorization-id</string>
    <string>WORKBENCH_AUTHORIZATION_UUID</string>
    <string>--account-id-hash</string>
    <string>CONFIRMED_LOCAL_ACCOUNT_ID_SHA256</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/ABSOLUTE/PATH/TO/legal-workbench</string>
  <key>StartInterval</key>
  <integer>300</integer>
  <key>RunAtLoad</key>
  <true/>
</dict>
</plist>
