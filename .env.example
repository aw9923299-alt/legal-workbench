# Runtime mode: mock | development | production
VITE_APP_MODE=mock

# API gateway used by the future backend-for-frontend service.
VITE_API_BASE_URL=http://localhost:3000/api

# Feishu OAuth application identifiers. Never commit secrets to the frontend.
VITE_FEISHU_APP_ID=
VITE_FEISHU_REDIRECT_URI=http://localhost:5173/auth/feishu/callback

# Feature flags
VITE_ENABLE_REAL_FEISHU=false
VITE_ENABLE_REAL_AGENTS=false
VITE_ENABLE_AUDIT_EXPORT=false
