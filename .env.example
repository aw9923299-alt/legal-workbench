# Docker Compose / PostgreSQL
POSTGRES_DB=legal_workbench
POSTGRES_USER=legal_workbench
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_PORT=5432
REDIS_PORT=6379
API_PORT=8000
WEB_PORT=5173

# Python backend settings (LEGAL_WORKBENCH_ prefix)
LEGAL_WORKBENCH_ENVIRONMENT=development
LEGAL_WORKBENCH_LOG_LEVEL=INFO
LEGAL_WORKBENCH_CORS_ORIGINS=["http://localhost:5173"]
LEGAL_WORKBENCH_DATABASE_URL=postgresql+psycopg://legal_workbench:change-me-local-only@localhost:5432/legal_workbench
LEGAL_WORKBENCH_REDIS_URL=redis://localhost:6379/0
LEGAL_WORKBENCH_KNOWLEDGE_ROOT=/data/knowledge
LEGAL_WORKBENCH_CODEX_RUNS_ROOT=/data/codex-runs
LEGAL_WORKBENCH_CODEX_COMMAND=codex
LEGAL_WORKBENCH_CODEX_RUN_TIMEOUT_SECONDS=900

# Feature gates: keep false until the corresponding integration is implemented and reviewed.
LEGAL_WORKBENCH_ENABLE_REAL_FEISHU=false
LEGAL_WORKBENCH_ENABLE_REAL_CODEX=false
LEGAL_WORKBENCH_ENABLE_EXTERNAL_SEND=false

# Feishu server-side credentials. Never expose these to the web app.
LEGAL_WORKBENCH_FEISHU_APP_ID=
LEGAL_WORKBENCH_FEISHU_APP_SECRET=
LEGAL_WORKBENCH_FEISHU_VERIFICATION_TOKEN=
LEGAL_WORKBENCH_FEISHU_ENCRYPT_KEY=

# Outbox publishing and retry policy
LEGAL_WORKBENCH_OUTBOX_BATCH_SIZE=50
LEGAL_WORKBENCH_OUTBOX_LOCK_SECONDS=60
LEGAL_WORKBENCH_OUTBOX_MAX_ATTEMPTS=8
LEGAL_WORKBENCH_OUTBOX_RETRY_BASE_SECONDS=15
LEGAL_WORKBENCH_OUTBOX_RETRY_MAX_SECONDS=3600
LEGAL_WORKBENCH_OUTBOX_WORKER_ID=local-outbox-worker
